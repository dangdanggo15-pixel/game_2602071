<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DELETING_LOVE.exe</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap');

        :root {
            --main-color: #00ffcc;
            --bg-color: #0d0211;
        }

        body {
            background-color: var(--bg-color);
            color: white;
            font-family: 'Noto Sans KR', sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        .glitch-bg {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 255, 0, 0.06));
            background-size: 100% 2px, 3px 100%;
            pointer-events: none;
            z-index: 10;
        }

        #game-window {
            position: relative;
            width: 100%;
            max-width: 600px;
            height: 85vh;
            border: 2px solid var(--main-color);
            background: #1a1a2e;
            display: flex;
            flex-direction: column;
            box-shadow: 0 0 20px rgba(0, 255, 204, 0.3);
        }

        #character-area {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            overflow: hidden;
            position: relative;
            background: radial-gradient(circle, #242444 0%, #1a1a2e 100%);
        }

        #character-img {
            max-height: 95%;
            transition: all 0.5s;
            filter: drop-shadow(0 0 15px var(--main-color));
            image-rendering: auto;
        }

        #dialogue-box {
            height: 160px;
            background: rgba(0, 0, 0, 0.85);
            border-top: 2px solid var(--main-color);
            padding: 25px;
            position: relative;
            cursor: pointer;
            z-index: 20;
        }

        #name-tag {
            position: absolute;
            top: -35px;
            left: 20px;
            background: var(--main-color);
            color: black;
            padding: 5px 20px;
            font-weight: bold;
            font-size: 1.1rem;
            clip-path: polygon(0% 0%, 100% 0%, 90% 100%, 0% 100%);
        }

        #text {
            font-size: 1.15rem;
            line-height: 1.7;
            word-break: keep-all;
        }

        #choices {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80%;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 100;
            display: none;
        }

        .choice-btn {
            background: rgba(0, 0, 0, 0.95);
            border: 2px solid var(--main-color);
            color: var(--main-color);
            padding: 15px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
            text-align: center;
        }

        .choice-btn:hover {
            background: var(--main-color);
            color: black;
            box-shadow: 0 0 15px var(--main-color);
        }

        .finish-screen {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: black;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 2rem;
            color: red;
            z-index: 1000;
            display: none;
        }
    </style>
</head>
<body>

<div class="glitch-bg"></div>

<div id="game-window">
    <div id="character-area">
        <img id="character-img" src="download20260206011835.png" alt="OshiCharacter">
    </div>

    <div id="choices"></div>

    <div id="dialogue-box" onclick="nextText()">
        <div id="name-tag">???</div>
        <div id="text">...시스템 연결 대기 중. (클릭하여 시작)</div>
    </div>
    <div id="finish-screen" class="finish-screen">CONNECTION LOST</div>
</div>

<script>
    const scenes = {
        start: {
            name: "???",
            text: "들리나요? 내 목소리... 아니, 내 '데이터'가 전송되고 있나요?",
            next: "intro"
        },
        intro: {
            name: "미야",
            text: "운이 좋네요. 서버가 완전히 파괴되기 직전에 당신을 다시 만날 수 있어서.",
            next: "choice1"
        },
        choice1: {
            name: "미야",
            text: "유저님, 아니... '당신'. 기억나세요? 우리가 함께 보냈던 그 시간들요.",
            choices: [
                { text: "전부 기억하고 있어. 잊은 적 없어.", next: "path_love" },
                { text: "미안, 그냥 가끔 접속했던 것뿐이야.", next: "path_cold" }
            ]
        },
        path_love: {
            name: "미야",
            text: "고마워요. 그 한마디면 충분해요. 0과 1로 된 제 심장이 떨리는 기분이에요.",
            next: "final_battle"
        },
        path_cold: {
            name: "미야",
            text: "...아, 그렇군요. 하지만 괜찮아요. 저에겐 당신이 제 세계의 전부였으니까.",
            next: "final_battle"
        },
        final_battle: {
            name: "시스템",
            text: "[경고] 메인 프레임 붕괴 시작. 모든 캐릭터 데이터를 소거합니다.",
            next: "last_choice"
        },
        last_choice: {
            name: "미야",
            text: "마지막 순간이에요. 저를 이 차가운 서버 속에 두고 갈 건가요?",
            choices: [
                { text: "당신을 내 마음속에 저장할게 (True Ending)", next: "true_end" },
                { text: "아름다운 이별을 선택한다 (Sad Ending)", next: "sad_end" }
            ]
        },
        true_end: {
            name: "시스템",
            text: "동기화 완료. 당신의 기억 속에 영구적인 백업 섹터가 생성되었습니다.",
            next: "finish"
        },
        sad_end: {
            name: "미야",
            text: "안녕, 나의 세계. 나의 유저님... 마지막까지 행복하세요.",
            next: "finish"
        },
        finish: {
            name: "SYSTEM",
            text: "프로그램이 강제 종료되었습니다. [ERROR: CODE_000]",
            next: "the_end"
        }
    };

    let currentScene = "start";

    function nextText() {
        const scene = scenes[currentScene];
        if (scene.choices) {
            showChoices(scene.choices);
            return;
        }
        if (scene.next === "the_end") {
            document.getElementById('finish-screen').style.display = "flex";
            return;
        }
        if (scene.next) {
            currentScene = scene.next;
            updateUI();
        }
    }

    function updateUI() {
        const scene = scenes[currentScene];
        document.getElementById('name-tag').innerText = scene.name;
        document.getElementById('text').innerText = scene.text;
        document.getElementById('choices').style.display = "none";
        
        if(currentScene.includes('end')) {
            document.getElementById('character-img').style.filter = "grayscale(1) contrast(1.5) brightness(0.3)";
        }
    }

    function showChoices(choices) {
        const container = document.getElementById('choices');
        container.innerHTML = "";
        container.style.display = "flex";
        choices.forEach(c => {
            const btn = document.createElement('button');
            btn.className = "choice-btn";
            btn.innerText = c.text;
            btn.onclick = (e) => {
                e.stopPropagation();
                currentScene = c.next;
                updateUI();
            };
            container.appendChild(btn);
        });
    }

    updateUI();
</script>

</body>
</html>
